{
  "name": "kuro-openclaw-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "库洛 · OpenClaw 桌面工作台",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node tests/electron-smoke.mjs",
    "test:live2d": "node tests/live2d-smoke.mjs",
    "package:icon": "electron scripts/create-icon.cjs",
    "package": "npm run build && npm run package:icon && electron-builder --win portable --x64 --publish never",
    "package:dir": "npm run build && npm run package:icon && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "6.5.10",
    "lucide-react": "^0.468.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  }
}
